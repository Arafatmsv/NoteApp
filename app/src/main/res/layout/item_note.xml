<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_yellow"
    android:layout_margin="5dp"
    android:padding="10dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/txt_item_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:textSize="23sp"
        android:textColor="@color/black"
        tools:text="План на жизнь"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/txt_item_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="План на жизнь"/>

    <TextView
        app:layout_constraintTop_toBottomOf="@+id/txt_item_description"
        app:layout_constraintStart_toStartOf="parent"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/black"
        tools:text="30 мая"
        android:textSize="18sp"
        android:id="@+id/txt_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/txt_item_date"
        app:layout_constraintTop_toTopOf="@+id/txt_item_date"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/black"
        tools:text="17:41"
        android:textSize="18sp"
        android:id="@+id/txt_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>